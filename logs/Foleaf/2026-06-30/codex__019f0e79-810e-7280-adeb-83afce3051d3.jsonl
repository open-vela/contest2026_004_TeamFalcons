4\t *  LEDs.  If CONFIG_ARCH_LEDS is not defined, then the board_userled() is\n    95\t *  available to control the LED from user application logic.\n    96\t *\n    97\t ****************************************************************************/\n    98\t\n    99\tvoid board_userled(int led, bool ledon)\n   100\t{\n   101\t  if ((unsigned)led < ARRAYSIZE(g_ledcfg))\n   102\t    {\n   103\t      stm32_gpiowrite(g_ledcfg[led], ledon);\n   104\t    }\n   105\t}\n"}
