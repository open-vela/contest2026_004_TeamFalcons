#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config LVX_USE_DEMO_CONTEST2026_004_VELAGUARD_APP
	bool "Contest 2026 team 004 Velaguard"
	default n
    select ARCH_HAVE_LEDS
	---help---
		Enable the contest 2026 team 000 hello app demo.

config VG_BRINGUP_TOOLS
	bool "VelaGuard bring-up tools (vgpwm/vgrs485/vgesp/vgmqtt/vgmodbus/vgnet + entrypoint app)"
	default LVX_USE_DEMO_CONTEST2026_004_VELAGUARD_APP
	select ARCH_HAVE_LEDS
	---help---
		Build the VelaGuard system entrypoint (velaguard_app_main) and the
		bring-up tools vgpwm/vgrs485/vgesp/vgmqtt/vgmodbus as NSH commands.
		The entrypoint runs the main loop persistently and hosts an NSH
		thread for shell debugging (board initialization runs once via
		NSH_ARCHINIT). Defaults to the LVGL demo switch so the existing
		Windows build path (ps1) keeps building them, while the
		velaguard-min preset can enable them independently of LVGL/LVX
		demo symbols.

config VG_CONFIG_STORE
	bool "VelaGuard dual-slot config store (eMMC FAT)"
	default n
	depends on VG_BRINGUP_TOOLS
	---help---
		Build vg_config_store and the NSH tool vgcfg.  Requires a writable
		FAT mount (e.g. /data/velaguard/config via velaguard-net).  Implements
		dual-slot + CRC + seq atomic commit for power-fail safety.

if VG_CONFIG_STORE

config VG_CONFIG_BASEDIR
	string "Config slot directory on mounted FS"
	default "/data/velaguard/config"
	---help---
		Directory holding point_table_a.json / point_table_b.json.

endif

config VG_FRAME_STATS
	bool "VelaGuard frame quality stats (Modbus/RS485)"
	default n
	depends on VG_BRINGUP_TOOLS
	---help---
		Build vg_frame_stats and NSH tool vgstats.  vgmodbus records
		CRC/timeout/latency into a per-slave sliding window.

config VG_NET_FAILOVER
	bool "VelaGuard TCP failover (RJ45 / ESP-01S)"
	default n
	depends on VG_BRINGUP_TOOLS && NET && NETUTILS_ESP8266 && NETUTILS_MQTTC && NETUTILS_PING
	---help---
		Start vg_net_mgr from velaguard_app_main (no NSH required).
		Ping eth0 only to judge RJ45 health; hot-standby join ESP-01S;
		fail over the single MQTT-C TCP session to lesp_* when RJ45 is
		unhealthy; reclaim RJ45 after the hold window. NSH ping is not
		redirected to Wi-Fi.

if VG_NET_FAILOVER

config VG_WIFI_SSID
	string "ESP-01S Wi-Fi SSID (hot-standby join)"
	default "19y"
	---help---
		Default AP SSID loaded into RAM at boot. Overridable at runtime
		via "vgnet wifi <ssid> <psk>".

config VG_WIFI_PASSWORD
	string "ESP-01S Wi-Fi password"
	default "12345678"
	---help---
		Default AP PSK paired with VG_WIFI_SSID (test credentials).

config VG_MQTT_BROKER_HOST
	string "Failover MQTT broker host"
	default "107.174.123.74"
	---help---
		Plaintext MQTT-C broker used as the first TCP client proving
		the active egress. CONNACK marks the session online.

config VG_MQTT_BROKER_PORT
	int "Failover MQTT broker port"
	default 1883
	---help---
		Broker TCP port (no TLS in this stage).

config VG_NET_PING_HOST
	string "Ping target if DHCP gateway is empty"
	default "223.5.5.5"
	---help---
		Fallback ICMP target when eth0 has no DHCP gateway. Ping is
		only an RJ45 health probe, not a traffic failover path.

endif

config VG_AGENT_OPS
	bool "VelaGuard agent ops (Skill seed + alarm monitor)"
	default n
	depends on VG_BRINGUP_TOOLS && VG_FRAME_STATS
	---help---
		Seed alarm_interpretation / operations_report Skills and
		HEARTBEAT.md; run a background alarm detector writing
		/data/velaguard/pending_alarm.txt for Agent pickup.

config VG_TIME_SYNC
	bool "VelaGuard wall-time persist + SNTP sync (Beijing)"
	default n
	depends on VG_BRINGUP_TOOLS
	---help---
		No battery RTC on the DK board: restore wall time from eMMC
		clock.txt at boot, persist it every 3 minutes (tmp + rename),
		and SNTP-sync to Beijing time (UTC+8 wall clock) whenever the
		RJ45 egress has an IP. With VG_NET_FAILOVER off the thread only
		restores/persists; SNTP requires the failover manager.

if VG_TIME_SYNC

config VG_TIME_SYNC_PATH
	string "Wall-time persistence file"
	default "/data/velaguard/clock.txt"
	---help---
		eMMC file holding the last known wall time (seconds since
		epoch, Beijing wall clock). tmp + rename for power-fail safety.

endif

if VG_AGENT_OPS

config VG_AGENT_AUTOSTART
	bool "Auto-start ai_agent task at boot"
	default y
	---help---
		Spawn ai_agent in a background task so cron/heartbeat can run
		without manual "ai_agent &". NSH remains on the console thread.

config VG_AGENT_ALARM_SLAVE
	int "Alarm monitor Modbus slave address"
	default 1

config VG_AGENT_ALARM_POLL_SEC
	int "Alarm poll interval (seconds)"
	default 60

config VG_AGENT_ALARM_TEMP_REG
	int "Temperature holding register index"
	default 0

config VG_AGENT_ALARM_TEMP_THRESHOLD
	int "Temperature alarm threshold (raw register value)"
	default 3000

config VG_AGENT_ALARM_OFFLINE_PCT
	int "Offline alarm when timeout percent exceeds"
	default 50

endif

config VG_BUS_DISCOVER
	bool "Modbus bus discover (vgdiscover @9600)"
	default n
	depends on VG_BRINGUP_TOOLS && VG_CONFIG_STORE
	---help---
		NSH tool vgdiscover: fixed-9600 address scan, register block probe,
		candidate point table JSON, and apply to /data/velaguard/config.
		NSH tool vgpoint: host serial add/set/test/apply --confirm.

if VG_BUS_DISCOVER

config VG_DISCOVER_DEVPATH
	string "RS485 device for discovery"
	default "/dev/rs485"

config VG_DISCOVER_BAUD
	int "Discovery baud rate"
	default 9600

config VG_DISCOVER_ADDR_MIN
	int "Scan address minimum"
	default 1

config VG_DISCOVER_ADDR_MAX
	int "Scan address maximum"
	default 32

config VG_DISCOVER_INTER_MS
	int "Inter-probe delay (ms)"
	default 50

config VG_DISCOVER_REG_MAX
	int "Max holding register to probe"
	default 120

config VG_DISCOVER_CANDIDATE_PATH
	string "Candidate point table JSON path"
	default "/data/velaguard/discover/point_table_candidate.json"

config VG_DISCOVER_POINTS_PATH
	string "Applied points JSON path"
	default "/data/velaguard/config/points.json"

config VG_LIVE_VALUES_PATH
	string "HMI live values snapshot path"
	default "/data/velaguard/live/values.txt"
	---help---
		Atomic text snapshot written after each HMI poll round.
		vgpoint get reads this file and must not take the RS485 lock.

endif

config VG_HMI
	bool "VelaGuard LVGL HMI (NSH vghmi)"
	default n
	depends on GRAPHICS_LVGL
	---help---
		Build vghmi: LTDC + touch HMI entry (Phase B).
		When VG_BRINGUP_TOOLS is also on (velaguard-lvgl-net merge),
		autostart from velaguard_app_main if VG_HMI_AUTOSTART.

if VG_HMI

config VG_HMI_PRIORITY
	int "vghmi task priority"
	default 100

config VG_HMI_STACKSIZE
	int "vghmi stack size"
	default 49152

config VG_HMI_AUTOSTART
	bool "Auto-start vghmi from velaguard_app_main"
	default y
	depends on VG_BRINGUP_TOOLS
	---help---
		Spawn vghmi after /dev/fb0 appears so the demo firmware
		does not require typing "vghmi &" on NSH.

config VG_HMI_INPUT_DEVPATH
	string "Touchscreen device path"
	default "/dev/input0"

config VG_HMI_DISCOVER
	bool "HMI Modbus bus discover (9600 scan via work queue)"
	default y
	---help---
		Link vg_bus_scan for the discover page. Requires RS485 UART
		(UART7 /dev/rs485) in board defconfig.

if VG_HMI_DISCOVER

config VG_HMI_RS485_DEVPATH
	string "RS485 device for HMI discover"
	default "/dev/rs485"

config VG_HMI_DISCOVER_BAUD
	int "Discover baud rate"
	default 9600

config VG_HMI_DISCOVER_ADDR_MIN
	int "Scan address minimum"
	default 1

config VG_HMI_DISCOVER_ADDR_MAX
	int "Scan address maximum"
	default 32

config VG_HMI_DISCOVER_INTER_MS
	int "Inter-probe delay (ms)"
	default 50

endif

config VG_HMI_REPORT_DIR
	string "Agent daily report directory"
	default "/data/velaguard/reports"

endif
