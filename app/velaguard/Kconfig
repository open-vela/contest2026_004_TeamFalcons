config VG_AGENT_OPS
	bool "VelaGuard agent ops (Skill seed + alarm monitor)"
	default n
	depends on VG_BRINGUP_TOOLS && VG_FRAME_STATS
	---help---
		Seed alarm_interpretation / operations_report Skills and
		HEARTBEAT.md; run a background alarm detector writing
		/data/velaguard/pending_alarm.txt for Agent pickup.

config VG_PTT
	bool "VelaGuard USER1 push-to-talk event thread (vgptt)"
	default n
	depends on VG_BRINGUP_TOOLS && INPUT_BUTTONS && ARCH_IRQBUTTONS
	---help---
		Watch the board USER1 button through /dev/buttons and turn
		press/release into record start and submit events: debounce,
		the 15 second cap, and the release gate before accepting the
		next press.  Exposes the NSH command vgptt for start/stop/
		status/reset.

		This task is the event layer only.  It records no audio and
		makes no network request; the default handler prints one line
		per event until BVO-03/05 supply a recording backend.

		Requires the board button support (STM32H750B_DK_BUTTONS plus
		ARCH_BUTTONS, ARCH_IRQBUTTONS, INPUT_BUTTONS and
		INPUT_BUTTONS_LOWER).

if VG_PTT

config VG_PTT_DEVPATH
	string "Button device path"
	default "/dev/buttons"

config VG_PTT_PRIORITY
	int "vgptt thread priority"
	default 90
	---help---
		Above the HMI (100 in the default preset) so a button edge is
		handled promptly, below the high-priority work queue (224).

config VG_PTT_STACKSIZE
	int "vgptt thread stack size"
	default 4096
	---help---
		The thread only runs poll(), one read() per wake-up and the
		event callback.  The callback is responsible for its own stack
		use when it is replaced by the recording layer.

config VG_PTT_AUTOSTART
	bool "Auto-start vgptt from velaguard_app_main"
	default y
	depends on VG_PTT
	---help---
		Spawn the button thread at boot so the USER1 button works
		without typing "vgptt start" on NSH.

endif # VG_PTT

config VG_VOICE_LOOPBACK
	bool "Local record/playback loop (vgvoice)"
	default n
	depends on VG_BRINGUP_TOOLS && VG_PTT && AUDIO && I2S && \
	          STM32H7_SAI_CAPTURE && STM32H7_SAI1_A && \
	          STM32H7_SAI_PDM_MODE && SYSTEM_NXPLAYER
	---help---
		Press USER1 to record from the on-board PDM microphone, release
		to stop and play the recording back through the WM8994 codec.

		This is a diagnostic entry, not a product voice UI: no ASR, no
		TTS, no network, no LVGL overlay.  It exists so the local audio
		path can be acceptance-tested on its own, and it reuses the
		BVO-02 button event layer and the BVO-04 standard NxPlayer path.

		Recording runs a circular DMA over a fixed ring, decimates the
		PDM bitstream to 16 kHz mono PCM with filter state carried across
		DMA halves (so the stream stays continuous), and keeps at most one
		15-second recording in RAM.  Recording and playback are mutually
		exclusive.  Every round removes its temporary WAV.

if VG_VOICE_LOOPBACK

config VG_VOICE_PRIORITY
	int "vgvoice record task priority"
	default 110
	---help---
		Priority of the resident task that decimates queued blocks while a
		recording is in progress.  It must sit above the HMI so half-ring
		handovers are consumed well within their 64 ms arrival interval,
		and below the high-priority work queue (224) so DMA completion
		callbacks are never delayed by it.

config VG_VOICE_STACKSIZE
	int "vgvoice record task stack size"
	default 4096
	---help---
		The task runs decimation, bounded WAV writes and NxPlayer control.

config VG_VOICE_TLS_CACHE
	bool "Experimental TLS session cache for voice"
	default n
	depends on EXAMPLES_AI_AGENT_VELA
	---help---
		诊断用会话恢复缓存。出现完整握手签名校验失败后默认关闭，
		待独立验证长期生命周期后再启用。

config VG_VOICE_TEST_FIXTURE
	bool "Local voice fault fixture (diagnostic image only)"
	default n
	depends on EXAMPLES_AI_AGENT_VELA
	---help---
		仅用于无人值守的整轮故障验收。NSH 显式选择固定夹具场景后，
		ASR/TTS 只连接固定本地主机，并使用无效测试凭据。
		不修改 provision，不注册为设备端 Agent 工具。发布预设关闭此项。

config VG_VOICE_DIRECT_TOOL
	bool "Run the resolved voice query without a model round (diagnostic only)"
	default n
	depends on VG_VOICE_LOOPBACK
	---help---
		The C layer resolves the three voice intents and the exact point
		before anything is sent, and the answer is rendered from the
		facts the read-only tool publishes.  A model round would only
		repeat that choice while spending 5 to 9 s of the 30 s budget on
		the request, so with this option the voice round executes the
		read-only tool through the agent tool registry directly.

		Turning it off restores the model round, which selects the same
		tool and then reads the same facts again.

config VG_VOICE_ASR_MODEL
	string "ASR model name"
	default "mimo-v2.5-asr"
	---help---
		Model name sent with a recognition request.  It must exist on the
		same endpoint and be covered by the configured key; the Base URL
		and the key are a pair and are not chosen here.

config VG_VOICE_TTS_MODEL
	string "TTS model name"
	default "mimo-v2.5-tts"
	---help---
		Model name sent with a synthesis request.

config VG_VOICE_TTS_VOICE
	string "TTS voice name"
	default "冰糖"
	---help---
		Voice used for synthesis.  The name is passed through as UTF-8.

endif # VG_VOICE_LOOPBACK

config VG_PDM_DUMP
	bool "Raw PDM capture probe (vgpdmdump)"
	default n
	depends on VG_BRINGUP_TOOLS && AUDIO && I2S && STM32H7_SAI1_A
	---help---
		Bring-up instrument for the on-board PDM microphone. Captures a
		fixed-length raw PDM bitstream from SAI1 block A, prints duty
		cycle, entropy and a nibble histogram, and optionally writes the
		bytes to a file for off-board analysis.

		This does no PDM-to-PCM decimation and is not part of the product
		audio path. It is meant to answer one question: is the microphone
		producing a real bitstream, or is the data line stuck. Requires the
		board bring-up to have registered the SAI1 capture device.

config VG_AUDIO_PROBE
	bool "Audio output bring-up probe (vgaudio)"
	default n
	depends on VG_BRINGUP_TOOLS && AUDIO_WM8994
	---help---
		Reports WM8994 ID/registers on I2C4 and SAI2 TX state. Installs
		bounded, known stereo WAV fixtures under /mnt/emmc/bvo04 and checks
		synchronous rejection of invalid TX requests. Playback uses NxPlayer;
		this probe never writes codec control registers directly.

config VG_HEAP_WATCH
	bool "DEBUG: watch SDRAM heap region first node (corruption hunt)"
	default n
	depends on VG_BRINGUP_TOOLS
	---help---
		Temporary debug aid. Spawns a thread polling the first heap
		node of the SDRAM region (0xd0100000) and dumping context
		bytes on change. Do not enable in release builds.

config VG_TIME_SYNC
	bool "VelaGuard wall-time persist + SNTP sync (Beijing)"
	default n
	depends on VG_BRINGUP_TOOLS
	---help---
		No battery RTC on the DK board: restore wall time from eMMC
		clock.txt at boot, persist it every 3 minutes (tmp + rename),
		and SNTP-sync to Beijing time (UTC+8 wall clock) whenever the
		RJ45 egress has an IP. With VG_NET_FAILOVER off the thread only
		restores/persists; SNTP requires the failover manager.

if VG_TIME_SYNC

config VG_TIME_SYNC_PATH
	string "Wall-time persistence file"
	default "/data/velaguard/clock.txt"
	---help---
		eMMC file holding the last known wall time (seconds since
		epoch, Beijing wall clock). tmp + rename for power-fail safety.

endif

