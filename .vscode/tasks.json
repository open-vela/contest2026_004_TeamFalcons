{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "openvela: prepare IntelliSense headers (WSL)",
      "type": "shell",
      "command": "bash \"${workspaceFolder}/scripts/prepare_wsl_intellisense.sh\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "openvela: reopen workspace in WSL for IntelliSense",
      "type": "shell",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$(wslpath -w \"${workspaceFolder}/scripts/windows_open_vscode_wsl.ps1\")\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "detail": "Use when the folder was opened as a Windows UNC path instead of Remote - WSL."
    },
    {
      "label": "openvela: build firmware via Windows host script (scaffold)",
      "type": "shell",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$(wslpath -w \"${workspaceFolder}/scripts/windows_build_openvela.ps1\")\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "detail": "Scaffold: WSL compile bridged from the Windows host script. Product app selection will be adapted later."
    },
    {
      "label": "openvela: flash firmware via CubeProgrammer (scaffold)",
      "type": "shell",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$(wslpath -w \"${workspaceFolder}/scripts/windows_flash_cube.ps1\")\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "detail": "Scaffold: Windows CubeProgrammer QSPI path. Requires ST-LINK + STM32CubeProgrammer on Windows."
    },
    {
      "label": "openvela: flash current artifacts only (scaffold)",
      "type": "shell",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$(wslpath -w \"${workspaceFolder}/scripts/windows_flash_cube.ps1\")\" -NoBuild",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Scaffold: program existing .debug artifacts without rebuilding."
    }
  ]
}
