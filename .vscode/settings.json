{
  // Cursor cannot install ms-vscode.cpptools; use clangd + ../nuttx/compile_commands.json.
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.path": "${workspaceFolder}/scripts/wsl_clangd_launcher.sh",
  "clangd.onConfigChanged": "restart",
  "clangd.checkUpdates": false,
  "clangd.arguments": [
    "--background-index",
    "--compile-commands-dir=${workspaceFolder}/../nuttx",
    "--query-driver=${workspaceFolder}/../prebuilts/gcc/linux-x86_64/arm-none-eabi/bin/arm-none-eabi-*"
  ],
  "files.exclude": {
    "**/.git": true,
    "**/.debug": true,
    "**/build": true,
    "**/*.o": true,
    "**/.built": true,
    "**/.depend": true,
    "**/Make.dep": true
  },
  "files.associations": {
    "*.c": "c",
    "*.h": "c",
    "*.defs": "makefile",
    "Make.defs": "makefile",
    "Kconfig": "plaintext",
    "**/Kconfig": "plaintext",
    "Kconfig.*": "plaintext",
    "defconfig": "plaintext",
    "*.defconfig": "plaintext"
  },
  "files.watcherExclude": {
    "**/.debug/**": true,
    "**/build/**": true,
    "**/logs/**": true,
    "**/*.o": true,
    "../nuttx/**/*.o": true,
    "../apps/**/*.o": true
  },
  "search.exclude": {
    "**/.debug": true,
    "**/build": true,
    "**/*.o": true,
    "../nuttx/**/*.o": true
  },
  "cmake.ignoreCMakeListsMissing": true,

  // Remote - WSL debug: GDB/OpenOCD launchers read machine paths from env vars
  // (see .env.example). Optional Windows-host overrides go in the gitignored
  // .vscode/settings.local.json (see settings.local.json.example).
  "cortex-debug.gdbPath.linux": "${workspaceFolder}/scripts/wsl_gdb_launcher.sh",
  "cortex-debug.armToolchainPath.linux": "${workspaceFolder}/../prebuilts/gcc/linux-x86_64/arm-none-eabi/bin",
  "cortex-debug.openocdPath.linux": "${workspaceFolder}/scripts/wsl_openocd_launcher.sh"
}
