/build/
/out/
/.debug/
CMakeFiles/
CMakeCache.txt
compile_commands.json
*.o
*.a
*.bin
*.elf
*.hex
*.map
# NuttX app build markers generated in the source tree via manifest link
.built
.depend
Make.dep

# Language and test caches
__pycache__/
*.py[cod]
.cache/
.pytest_cache/
.mypy_cache/
.venv/
venv/

# Host-side unit-test binaries (sources and Makefiles stay tracked)
app/velaguard/host_tests/test_net_policy

# Local AI / editor tooling (do not submit; contest code lives in-tree)
.claude
.claude/
.codex/
.cursor/
.grok/
.clangd

# Editor settings: keep the shared VS Code project configuration.
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/c_cpp_properties.json
.idea/
*.swp
*~

# Operating-system metadata
.DS_Store
Thumbs.db

# Local environment and secrets
.env
.env.*
!.env.example

# openvela contest AI Coding logs are collaboration artifacts and must be
# committed with the code they document.
!logs/
!logs/**
