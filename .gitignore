# Generated build artifacts
/build/
/out/
/.debug/
CMakeFiles/
CMakeCache.txt
compile_commands.json
*.o
*.a
*.bin
*.elf
*.hex
*.map
# NuttX app intermediates: redirected to build/velaguard/ via Makefile PREFIX.
# Keep these ignore rules as a safety net if PREFIX is unset or stale files linger.
.built
.depend
Make.dep

# Language and test caches
__pycache__/
*.py[cod]
.cache/
.pytest_cache/
.mypy_cache/
.venv/
venv/

# Host-side unit-test binaries (sources and Makefiles stay tracked)
app/velaguard/host_tests/test_net_policy
app/velaguard/host_tests/test_frame_stats
app/velaguard/host_tests/test_config_store
app/velaguard/host_tests/test_discover
app/velaguard/host_tests/test_vgpoint
app/velaguard/host_tests/test_alarm_eval
app/velaguard/host_tests/test_time_sync
app/velaguard/host_tests/test_hmi_perf
app/velaguard/host_tests/test_hmi_sched
app/velaguard/host_tests/test_runtime_render

# Local AI / editor tooling (do not submit; contest code lives in-tree)
.claude
.claude/
.codex/
.zcode/
.cursor/*
!.cursor/hooks.json
!.cursor/hooks/
!.cursor/hooks/**
!.cursor/rules/
!.cursor/rules/**
!.cursor/skills/
!.cursor/skills/**

# Accidental apt downloads (do not submit)
*.deb
.grok/
# .clangd is committed (portable include flags for all machines)

# Editor settings: keep the shared VS Code project configuration.
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/c_cpp_properties.json
!.vscode/settings.local.json.example
.vscode/settings.local.json
.idea/
*.swp
*~

# Operating-system metadata
.DS_Store
Thumbs.db

# Local environment and secrets
.env
.env.*
!.env.example
.env.local

# ai_agent LLM secrets (local only; provision to eMMC encrypted)
secrets/agent_llm.key
secrets/agent_llm.endpoint
app/velaguard/agent_secrets.h

# openvela contest AI Coding logs are collaboration artifacts and must be
# committed with the code they document.
!logs/
!logs/**
# Collector local failure dumps (not scored session transcripts)
logs/**/errors/

# Host test binaries built by `make -C app/velaguard/host_tests test`
/app/velaguard/host_tests/test_*
!/app/velaguard/host_tests/test_*.c

# Report build leftovers: bundled font copy is unused (figures read system
# fonts), the preview zip is a local packaging step, and REQUIREMENTS.md holds
# internal wording that is not part of the submission.
/docs/submission/fonts/
/docs/submission/TeamFalcons-*-PREVIEW.zip
/docs/submission/REQUIREMENTS.md
